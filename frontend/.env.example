# Server-only. NO NEXT_PUBLIC_ PREFIX — the browser must never learn this URL.
#
# If you ever feel you need NEXT_PUBLIC_STRAPI_URL, stop: it means a Strapi call has
# ended up in a Client Component. Move it to a Server Component or a Server Action.
# Anything prefixed NEXT_PUBLIC_ is inlined into the JavaScript bundle and shipped to
# every visitor.
#
# No trailing slash — lib/strapi.ts concatenates paths onto this directly.
STRAPI_URL=http://localhost:1337

# Encrypts the Auth.js session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Required on Vercel, where the deployment host is not known at build time.
AUTH_TRUST_HOST=true
