HOST=0.0.0.0
PORT=1337

# Generate each with: openssl rand -base64 32
APP_KEYS=              # four comma-separated values
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=
JWT_SECRET=            # signs the USER tokens Next.js sends as Bearer tokens

# sqlite locally, postgres on Railway
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
DATABASE_URL=                          # Railway: variable reference, not a literal
DATABASE_SSL=false                     # true on Railway
DATABASE_SSL_REJECT_UNAUTHORIZED=false

NODE_ENV=development                   # production on Railway

FRONTEND_URL=http://localhost:3000     # CORS allowlist

SEED_DEMO_DATA=true
DEMO_USER_PASSWORD=                    # password for all seeded demo users
